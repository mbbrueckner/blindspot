\RequirePackage{tikz}

\tikzset{regenbogenband/.style={path picture={
  \pgfextractx\beamerfsu@logobbwidth{\pgfpointdiff{\pgfpointanchor{path picture bounding box}{south west}}
    {\pgfpointanchor{path picture bounding box}{north east}}}
  \pgfextracty\beamerfsu@logobbheight{\pgfpointdiff{\pgfpointanchor{path picture bounding box}{south west}}
    {\pgfpointanchor{path picture bounding box}{north east}}}
  \pgfmathsetlengthmacro\partwidth{\beamerfsu@logobbwidth/20}
  \fill[white] (path picture bounding box);
  \foreach \i/\v in {
      0/cdtheologie,
      2/cdphilosophie,
      4/cdrechtswiss,
      6/cdmedizin,
      8/cdphysik,
      10/cdwiwiss,
      12/cdchemie,
      14/cdbiowiss,
      16/cdmathematik,
      18/cdsozialwiss}{
    \fill[fill=\v] ([xshift={\i*\partwidth}]path picture bounding box.south west)
         rectangle ([xshift={(\i+1)*\partwidth}]path picture bounding box.north west);
    \fill[fill=\v!55!white] ([xshift={(\i+1)*\partwidth}]path picture bounding box.south west)
                  rectangle ([xshift={(\i+2)*\partwidth}]path picture bounding box.north west);
  }
}}}

